{
    "name": "queuesmart-backend",
    "version": "1.0.0",
    "description": "QueueSmart backend and front-end integration",
    "main": "src/server.js",
    "type": "commonjs",
    "scripts": {
        "start": "node --env-file=.env src/server.js",
        "dev": "node --watch --env-file=.env src/server.js",
        "test": "node --env-file=.env --test",
        "coverage": "node --env-file=.env --test --experimental-test-coverage",
        "seed:admin": "node --env-file=.env src/data/adminacc.js"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "express": "^5.1.0",
        "mysql2": "^3.11.0"
    },
    "allowScripts": {
        "bcrypt@6.0.0": true
    }
}
